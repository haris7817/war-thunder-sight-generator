rangefinderProgressBarColor1:c = 0, 255, 0, 64
rangefinderProgressBarColor2:c = 255, 255, 255, 64
rangefinderTextScale:r = 0.7
rangefinderVerticalOffset:r = 18
rangefinderHorizontalOffset:r = 5
fontSizeMult:r = 1
lineSizeMult:r = 1
drawCentralLineVert:b = yes
drawCentralLineHorz:b = yes
crosshairColor:c = 31, 239, 31, 255
crosshairLightColor:c = 255, 30, 30, 255
crosshairDistHorSizeMain:p2 = 0, 0
crosshairDistHorSizeAdditional:p2 = 0.005, 0.003
textPos:p2 = 0.14, 0
distanceCorrectionPos:p2 = 0.02, -0.005
drawDistanceCorrection:b = yes
useSmoothEdge:b = no
rangefinderUseThousandth:b = yes
detectAllyTextScale:r = 0.7
detectAllyOffset:p2 = 4, 0.025

crosshair_distances{
  distance:p3=200, 0, 0
  distance:p3=400, 4, 0
  distance:p3=600, 0, 0
  distance:p3=800, 8, 0
  distance:p3=1000, 0, 0
  distance:p3=1200, 12, 0
  distance:p3=1400, 0, 0
  distance:p3=1600, 16, 0
  distance:p3=1800, 0, 0
  distance:p3=2000, 20, 0
}

crosshair_hor_ranges{
}

matchExpClass {
  exp_tank:b = yes
  exp_heavy_tank:b = yes
  exp_tank_destroyer:b = yes
  exp_SPAA:b = yes
}

drawLines{
  line {line:p4=0.000000,0.000000,0.000000,-0.300000;move:b=false;}
  line {line:p4=0.000000,0.000000,0.300000,0.000000;move:b=false;}
  line {line:p4=-0.100000,-0.100000,0.100000,-0.100000;move:b=false;}
  line {line:p4=0.100000,-0.100000,0.100000,0.100000;move:b=false;}
  line {line:p4=0.100000,0.100000,-0.100000,0.100000;move:b=false;}
  line {line:p4=-0.100000,0.100000,-0.100000,-0.100000;move:b=false;}
}

drawQuads{
  quad {tl:p2=0.140000,-0.200000;tr:p2=0.200000,-0.200000;br:p2=0.200000,-0.140000;bl:p2=0.140000,-0.140000;}
}
